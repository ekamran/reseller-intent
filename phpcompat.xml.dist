<?xml version="1.0"?>
<ruleset name="Reseller Intent PHP compatibility">
	<description>Every shipped PHP file must run on PHP 7.4, the declared floor, through 8.4.</description>

	<file>.</file>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/blueprints/*</exclude-pattern>

	<arg value="ps"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>

	<config name="testVersion" value="7.4-"/>
	<rule ref="PHPCompatibilityWP">
		<!-- The removed-extension sniff matches any function whose name starts
		     with "fam", and this plugin has families() and family_ids(). -->
		<exclude name="PHPCompatibility.Extensions.RemovedExtensions.famRemoved"/>
	</rule>
</ruleset>
